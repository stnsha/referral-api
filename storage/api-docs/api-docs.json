        "/api/form": {
            "post": {
                "tags": [
                    "Forms"
                ],
                "summary": "Create a new form and its details",
                "operationId": "a45ee9957cd963fad67e9a6ef5dc11fd",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "business_unit_id",
                                    "label_name",
                                    "is_hidden",
                                    "is_required",
                                    "field_type"
                                ],
                                "properties": {
                                    "business_unit_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "label_name": {
                                        "type": "string",
                                        "example": "Physio Interventions"
                                    },
                                    "is_hidden": {
                                        "type": "boolean",
                                        "example": false
                                    },
                                    "is_required": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "field_name": {
                                        "type": "string",
                                        "example": "physio_interventions"
                                    },
                                    "field_type": {
                                        "type": "string",
                                        "example": "checkbox"
                                    },
                                    "value_fields": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "example": [
                                            "Chest Physiotherapy",
                                            "Pain Management"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Form created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Form created successfully!"
                                        },
                                        "form_id": {
                                            "type": "integer",
                                            "example": 1
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Form creation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Form creation failed"
                                        },
                                        "error": {
                                            "type": "string",
                                            "example": "Something went wrong"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
