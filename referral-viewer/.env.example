; Referral PDF Viewer - Service Account Configuration
; Copy this file to the deployment server alongside referral.php
; Ensure this file is NOT web-accessible (deny in .htaccess or Nginx config)

API_HOST=
API_KEY=

; Secret key for signing referral tokens (must match the key used when generating URLs on the letter)
; Change this to a strong random string and keep it private
TOKEN_SECRET=
TOKEN_EXPIRY_DAYS=365

; JWT token cache file path (must be writable by the web server user)
; Use an absolute path outside the web root, or a system temp directory
TOKEN_CACHE_FILE=/tmp/.referral_jwt_cache

; Seconds before JWT expiry to treat the cached token as expired (safety buffer)
TOKEN_CACHE_TTL_BUFFER=300
